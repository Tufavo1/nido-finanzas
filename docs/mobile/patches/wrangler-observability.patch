# PARCHE PREPARADO, NO APLICADO. Lo aplica el dueño (cambia produccion): git apply docs/mobile/patches/wrangler-observability.patch
# Activa los logs del Worker (hoy console.error/warn se pierden) con 10 % de muestreo de invocaciones y sin logs de cabeceras.
--- a/web/wrangler.jsonc
+++ b/web/wrangler.jsonc
@@ -11,6 +11,11 @@
     // El Worker solo atiende «/supabase/*» (el proxy); todo lo demás lo sirven los archivos estáticos directamente
     "run_worker_first": ["/supabase/*"]
   },
+  // Registros del Worker (Cloudflare > Workers > Observability). Sin esto los console.error/warn no se guardan.
+  "observability": {
+    "enabled": true,
+    "head_sampling_rate": 0.1
+  },
   // Límites por persona (IP). Periodo permitido: 10 o 60 segundos.
   "ratelimits": [
     { "name": "RL_GENERAL", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } },
