# Copia a .env.production.local (no se sube a git). .env.local apunta al Supabase local y tiene
# prioridad sobre .env.production, por eso se usa .local.
VITE_SUPABASE_URL=https://qhjnpxujhchmfykuslmr.supabase.co
# Clave publicable (sb_publishable_…): Supabase → Project Settings → API Keys. Nunca la secreta.
VITE_SUPABASE_KEY=
# Clave pública VAPID de las notificaciones push
VITE_VAPID_PUBLIC_KEY=
# Clave de SITIO de Cloudflare Turnstile (la secreta va en el panel de Supabase). Vacía = sin CAPTCHA.
VITE_TURNSTILE_SITE_KEY=
