{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nido-finanzas",
  "main": "worker/index.ts",
  // Cloudflare crea solo el registro DNS y el certificado de este subdominio al desplegar
  "routes": [{ "pattern": "contigo.dinovance.cl", "custom_domain": true }],
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // El Worker solo atiende «/supabase/*» (el proxy); todo lo demás lo sirven los archivos estáticos directamente
    "run_worker_first": ["/supabase/*"]
  },
  // Límites por persona (IP). Periodo permitido: 10 o 60 segundos.
  "ratelimits": [
    { "name": "RL_GENERAL", "namespace_id": "1001", "simple": { "limit": 240, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    // Guardar, editar y borrar: cupo aparte, más bajo que el de leer
    { "name": "RL_WRITE", "namespace_id": "1003", "simple": { "limit": 90, "period": 60 } }
  ]
  // Secretos (se crean con «npx wrangler secret put»; no van en este archivo ni en git):
  //   SUPABASE_ORIGIN  la dirección real del proyecto, https://xxxx.supabase.co
  //   SUPABASE_KEY     la clave publicable del proyecto
}
